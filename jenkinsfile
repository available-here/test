pipeline {
    agent any

    stages {
        stage('Matrix Tests') {
            matrix {
                // Defines the configuration combinations
                axes {
                    axis {
                        name 'NODE_VERSION'
                        values '18', '20', '22'
                    }
                    axis {
                        name 'OS'
                        values 'ubuntu-latest', 'windows-latest'
                    }
                }
                
                // Exclude specific invalid configurations if needed
                excludes {
                    exclude {
                        axis { name 'OS'; values 'windows-latest' }
                        axis { name 'NODE_VERSION'; values '18' }
                    }
                }

                // Stages executed for every combination
                stages {
                    stage('Build & Test') {
                        steps {
                            echo "Running on Branch: ${ENV:BRANCH_NAME}"
                            echo "Testing Node ${NODE_VERSION} on ${OS}"
                            // Replace with your actual build/test commands:
                            // sh 'npm ci && npm test'
                        }
                    }
                }
            }
        }
    }
}
